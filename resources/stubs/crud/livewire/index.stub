<?php

namespace {{livewireNamespace}}\{{modelNamePluralUpperCase}};

use App\Services\ListQueryBuilder;
use {{serviceNamespace}}\{{modelName}}Service;
use {{modelNamespace}}\{{modelName}};
{{catalogImports}}
use Illuminate\View\View;
use Livewire\Attributes\Url;
use Livewire\Component;
use Livewire\WithPagination;

class Index extends Component
{
    use WithPagination;

    #[Url]
    public string $sort = '-id';

    #[Url]
    public int $per_page = 15;
{{filterProperties}}

    public function updated(string $property): void
    {
        if (in_array($property, [{{filterPropertyList}}], true)) {
            $this->resetPage();
        }
    }

    public function clearFilters(): void
    {
{{clearFiltersBody}}
        $this->resetPage();
    }

{{catalogMethods}}
    public function confirmDelete(int $id): void
    {
        $this->js(livewire_swal_confirm_delete($id));
    }

    public function delete({{modelName}} ${{modelNameLowerCase}}, {{modelName}}Service $service)
    {
        $service->delete(${{modelNameLowerCase}});

        flash_swal_toast(__('Registro eliminado.'), 'success');

        return $this->redirectRoute('{{modelRoute}}.index');
    }

    public function render(): View
    {
        $request = request()->merge([
            'sort' => $this->sort,
            'per_page' => $this->per_page,
{{filterRequestMerge}}
        ]);

        ${{modelNamePluralLowerCase}} = ListQueryBuilder::for(
            {{modelName}}::query(){{eagerLoad}},
            [{{sortableColumns}}],
            [{{includeRelations}}]
        )
            ->withColumnFilters(
                textColumns: [{{textFilterColumns}}],
                exactColumns: [{{exactFilterColumns}}],
            )
            ->apply($request)
            ->paginate($request);

        return view('{{modelViewFull}}.index', compact('{{modelNamePluralLowerCase}}'))
            ->layout('components.layouts.app')
            ->with('i', ($this->getPage() - 1) * ${{modelNamePluralLowerCase}}->perPage());
    }
}
