{{catalogImports}}use Illuminate\View\View;
use Livewire\Component;

class Edit extends Component
{
    public {{modelName}}Form $form;

    public function mount({{modelName}} ${{modelNameLowerCase}}): void
    {
        $this->form->set{{modelName}}Model(${{modelNameLowerCase}});
    }
{{catalogMethods}}
    public function save({{modelName}}Service $service)
