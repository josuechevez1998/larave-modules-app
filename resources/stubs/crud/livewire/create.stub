<?php

namespace {{livewireNamespace}}\{{modelNamePluralUpperCase}};

use {{livewireNamespace}}\Forms\{{modelName}}Form;
use {{serviceNamespace}}\{{modelName}}Service;
{{catalogImports}}use Illuminate\View\View;
use Livewire\Component;

class Create extends Component
{
    public {{modelName}}Form $form;
{{catalogMethods}}
    public function save({{modelName}}Service $service)
    {
        $this->form->store($service);

        flash_swal_toast(__('Registro guardado.'), 'success');

        return $this->redirectRoute('{{modelRoute}}.index');
    }

    public function render(): View
    {
        return view('{{modelViewFull}}.create')
            ->layout('components.layouts.app');
    }
}
