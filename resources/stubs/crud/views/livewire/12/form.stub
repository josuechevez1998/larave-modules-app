<div class="space-y-6">
    {{form}}
    <div class="flex flex-wrap items-center gap-3 pt-2">
        <flux:button variant="primary" type="submit">{{ __('app.save') }}</flux:button>
        <flux:button variant="ghost" :href="route('{{modelRoute}}.index')" wire:navigate type="button">
            {{ __('Cancelar') }}
        </flux:button>
    </div>
</div>
