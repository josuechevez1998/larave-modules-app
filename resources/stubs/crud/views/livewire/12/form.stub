<div class="space-y-6">
    {{form}}
    <div class="flex flex-wrap items-center gap-3 pt-2">
        <x-ui.action-button target="save" />
        <flux:button
            variant="ghost"
            :href="route('{{modelRoute}}.index')"
            wire:navigate
            type="button"
            wire:loading.attr="disabled"
            wire:target="save"
        >
            {{ __('Cancelar') }}
        </flux:button>
    </div>
</div>
