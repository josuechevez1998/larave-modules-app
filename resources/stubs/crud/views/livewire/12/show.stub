<section class="w-full space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <flux:heading size="xl" level="1">{{ __('{{modelTitle}}') }}</flux:heading>
            <flux:subheading class="mt-1">{{ __('Detalle del registro') }}</flux:subheading>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <flux:button variant="ghost" :href="route('{{modelRoute}}.edit', ${{modelNameLowerCase}}->id)" wire:navigate>
                {{ __('Editar') }}
            </flux:button>
            <flux:button variant="ghost" :href="route('{{modelRoute}}.index')" wire:navigate>
                {{ __('Volver') }}
            </flux:button>
        </div>
    </div>

    <flux:separator variant="subtle" />

    <div class="ui-surface p-4 sm:p-8">
        <dl class="divide-y divide-stone-200 dark:divide-stone-700">
            {{viewRows}}
        </dl>
    </div>
</section>
