├── database/

│   ├── factories/

│   ├── migrations/

│   └── seeders/

│       └── BlogDatabaseSeeder.php

├── resources/

│   ├── assets/

│   │   ├── js/

│   │   │   └── app.js

│   │   └── sass/

│   │       └── app.scss

