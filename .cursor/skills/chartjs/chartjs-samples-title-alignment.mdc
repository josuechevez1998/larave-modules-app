```
const config = {
  type: 'line',
  data: data,
  options: {
    plugins: {
      title: {
        display: true,
        text: 'Chart Title',
      }
    }
  }
};
```

const DATA\_COUNT = 7;
const NUMBER\_CFG = {count: DATA\_COUNT, min: -100, max: 100};
const data = {
labels: Utils.months({count: DATA\_COUNT}),
datasets: [
{
label: 'Dataset 1',
data: Utils.numbers(NUMBER\_CFG),
fill: false,
borderColor: Utils.CHART\_COLORS.red,
backgroundColor: Utils.transparentize(Utils.CHART\_COLORS.red, 0.5),
},
]
};

```
const DATA_COUNT = 7;
const NUMBER_CFG = {count: DATA_COUNT, min: -100, max: 100};
const data = {
  labels: Utils.months({count: DATA_COUNT}),
  datasets: [
    {
      label: 'Dataset 1',
      data: Utils.numbers(NUMBER_CFG),
      fill: false,
      borderColor: Utils.CHART_COLORS.red,
      backgroundColor: Utils.transparentize(Utils.CHART_COLORS.red, 0.5),
    },
  ]
};
```

const actions = [
{
name: 'Title Alignment: start',
handler(chart) {
chart.options.plugins.title.align = 'start';
chart.update();
}
},
{
name: 'Title Alignment: center (default)',
handler(chart) {
chart.options.plugins.title.align = 'center';
chart.update();
}
},
{
name: 'Title Alignment: end',
handler(chart) {
chart.options.plugins.title.align = 'end';
chart.update();
}
},
];

```
const actions = [
  {
    name: 'Title Alignment: start',
    handler(chart) {
      chart.options.plugins.title.align = 'start';
      chart.update();
    }
  },
  {
    name: 'Title Alignment: center (default)',
    handler(chart) {
      chart.options.plugins.title.align = 'center';
      chart.update();
    }
  },
  {
    name: 'Title Alignment: end',
    handler(chart) {
      chart.options.plugins.title.align = 'end';
      chart.update();
    }
  },
];
```

