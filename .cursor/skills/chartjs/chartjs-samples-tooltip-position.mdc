const config = {
type: 'line',
data: data,
options: {
interaction: {
intersect: false,
mode: 'index',
},
plugins: {
title: {
display: true,
text: (ctx) => 'Tooltip position mode: ' + ctx.chart.options.plugins.tooltip.position,
},
}
}
};

