const actions = [
{
name: 'Randomize',
handler(chart) {
chart.data.datasets.forEach(dataset => {
dataset.data.forEach(function(dataObj, j) {
const newVal = Utils.rand(0, 100);
if (typeof dataObj === 'object') {
dataObj.y = newVal;
} else {
dataset.data[j] = newVal;
}
});
});
chart.update();
}
},
];

```
const actions = [
  {
    name: 'Randomize',
    handler(chart) {
      chart.data.datasets.forEach(dataset => {
        dataset.data.forEach(function(dataObj, j) {
          const newVal = Utils.rand(0, 100);
          if (typeof dataObj === 'object') {
            dataObj.y = newVal;
          } else {
            dataset.data[j] = newVal;
          }
        });
      });
      chart.update();
    }
  },
];
```

