const actions = [
{
name: 'Toggle Tooltip Point Style',
handler(chart) {
chart.options.plugins.tooltip.usePointStyle = !chart.options.plugins.tooltip.usePointStyle;
chart.update();
}
},
];

```
const actions = [
  {
    name: 'Toggle Tooltip Point Style',
    handler(chart) {
      chart.options.plugins.tooltip.usePointStyle = !chart.options.plugins.tooltip.usePointStyle;
      chart.update();
    }
  },
];
```

