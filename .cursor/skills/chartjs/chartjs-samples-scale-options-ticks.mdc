const actions = [
{
name: 'Alignment: start',
handler(chart) {
chart.options.scales.x.ticks.align = 'start';
chart.update();
}
},
{
name: 'Alignment: center (default)',
handler(chart) {
chart.options.scales.x.ticks.align = 'center';
chart.update();
}
},
{
name: 'Alignment: end',
handler(chart) {
chart.options.scales.x.ticks.align = 'end';
chart.update();
}
},
];

```
const actions = [
  {
    name: 'Alignment: start',
    handler(chart) {
      chart.options.scales.x.ticks.align = 'start';
      chart.update();
    }
  },
  {
    name: 'Alignment: center (default)',
    handler(chart) {
      chart.options.scales.x.ticks.align = 'center';
      chart.update();
    }
  },
  {
    name: 'Alignment: end',
    handler(chart) {
      chart.options.scales.x.ticks.align = 'end';
      chart.update();
    }
  },
];
